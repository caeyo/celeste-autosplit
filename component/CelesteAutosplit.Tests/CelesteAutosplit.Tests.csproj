<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>

    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CelesteAutosplit/CelesteAutosplit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="LiveSplit.Core" HintPath="$(LiveSplitDir)LiveSplit.Core.dll" />
    <Reference Include="LiveSplit.AutoSplittingRuntime" HintPath="$(LiveSplitDir)Components/LiveSplit.AutoSplittingRuntime.dll" />
  </ItemGroup>

  <PropertyGroup>
    <WasmPath>$(RepoRoot)autosplitter/target/wasm32-unknown-unknown/release/celeste_autosplit.wasm</WasmPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)legacy-splits/*" Link="legacy-splits/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(LiveSplitDir)Components/x64/asr_capi.dll" Link="Components/x64/asr_capi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(WasmPath)" Link="Components/celeste_autosplit.wasm" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(WasmPath)')" />
  </ItemGroup>

</Project>
