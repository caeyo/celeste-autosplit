<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- ASR's native library only has a runtime in 64-bit builds. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CelesteAutosplit/CelesteAutosplit.csproj" />
  </ItemGroup>

  <!-- Copied here (unlike the component) so tests can load LiveSplit and ASR types. -->
  <ItemGroup>
    <Reference Include="LiveSplit.Core" HintPath="$(LiveSplitDir)LiveSplit.Core.dll" />
    <Reference Include="UpdateManager" HintPath="$(LiveSplitDir)UpdateManager.dll" />
    <Reference Include="LiveSplit.AutoSplittingRuntime" HintPath="$(LiveSplitDir)Components/LiveSplit.AutoSplittingRuntime.dll" />
  </ItemGroup>

  <!--
    The output folder stands in for LiveSplit's folder: ASR loads its native library
    from Components\x64\, and the component looks for the wasm module in Components\.
    Build the wasm module first, in release mode (cargo b -r in autosplitter/).
  -->
  <PropertyGroup>
    <WasmPath>$(RepoRoot)autosplitter/target/wasm32-unknown-unknown/release/celeste_autosplit.wasm</WasmPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LiveSplitDir)Components/x64/asr_capi.dll" Link="Components/x64/asr_capi.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(WasmPath)" Link="Components/celeste-autosplit.wasm" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(WasmPath)')" />
  </ItemGroup>

</Project>
