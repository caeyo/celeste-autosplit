<Project>

  <PropertyGroup>
    <LiveSplitVersion>1.8.37</LiveSplitVersion>
    <LiveSplitUrl>https://github.com/LiveSplit/LiveSplit/releases/download/$(LiveSplitVersion)/LiveSplit_$(LiveSplitVersion).zip</LiveSplitUrl>
    <LiveSplitDepsDir>$(MSBuildThisFileDirectory).deps/</LiveSplitDepsDir>
    <LiveSplitDir>$(LiveSplitDepsDir)LiveSplit_$(LiveSplitVersion)/</LiveSplitDir>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../</RepoRoot>
    <SchemaPath>$(RepoRoot)schema/settings-schema.json</SchemaPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net4.8.1</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
