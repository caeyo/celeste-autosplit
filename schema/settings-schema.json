{
  "schema_version": 1,

  "settings": [
    {
      "key": "start",
      "type": "trigger",
      "default": { "kind": "manual" },
      "label": "Start",
      "description": "What starts the timer."
    },
    {
      "key": "splits",
      "type": "list",
      "items": "trigger",
      "default": [],
      "label": "Splits",
      "description": "One trigger per segment, in order. Segments without one are split by hand."
    },
    {
      "key": "timing_method",
      "type": "string",
      "default": "file",
      "label": "Timing method",
      "values": [
        { "value": "file", "label": "File time" },
        { "value": "chapter", "label": "Chapter time" },
        { "value": "file_since_start", "label": "File time since start" },
        { "value": "chapter_since_start", "label": "Chapter time since start" }
      ]
    },
    {
      "key": "auto_reset",
      "type": "bool",
      "default": false,
      "label": "Auto reset",
      "description": "Reset and start again whenever the start trigger fires during a run, including after it has ended."
    },
    {
      "key": "everest",
      "type": "bool",
      "default": false,
      "label": "Everest",
      "description": "Use data only Everest provides, such as matching chapters by SID."
    },
    {
      "key": "high_priority",
      "type": "bool",
      "default": true,
      "host": "livesplit",
      "label": "High priority",
      "description": "Set the Celeste process's priority to High."
    },
    {
      "key": "set_game_time",
      "type": "bool",
      "default": true,
      "host": "livesplit",
      "label": "Switch to Game Time",
      "description": "Switch LiveSplit's timing method to Game Time when the splits are loaded."
    }
  ],

  "fields": {
    "chapter": {
      "type": "i64",
      "label": "Chapter",
      "values_from": "chapters",
      "no_chapter": { "value": -1, "label": "Not in a chapter" }
    },
    "side": {
      "type": "i64",
      "label": "Side",
      "values": [
        { "value": 0, "label": "A-Side" },
        { "value": 1, "label": "B-Side" },
        { "value": 2, "label": "C-Side" }
      ]
    },
    "timing": {
      "type": "string",
      "label": "Split on",
      "default": "chapter_complete",
      "values": [
        { "value": "chapter_complete", "label": "Chapter complete" },
        { "value": "chapter_exit", "label": "Chapter exit" }
      ]
    },
    "checkpoint": {
      "type": "i64",
      "label": "Checkpoint",
      "values_from": "checkpoints"
    },
    "room": {
      "type": "string",
      "label": "Room",
      "description": "Exactly as the game names it, including case."
    },
    "sid": {
      "type": "string",
      "label": "Chapter SID",
      "everest": true,
      "replaces": "chapter"
    },
    "raw": {
      "type": "string",
      "label": "Legacy split",
      "read_only": true
    }
  },

  "triggers": [
    { "kind": "manual", "label": "Manual", "required": [], "optional": [], "offer": ["start", "splits"] },
    { "kind": "unknown", "label": "Unrecognised legacy split", "required": ["raw"], "optional": [], "offer": [] },
    { "kind": "new_file", "label": "New file", "required": [], "optional": [], "offer": ["start"] },
    { "kind": "chapter_start", "label": "Chapter start", "required": [], "optional": ["chapter", "side", "sid"], "offer": ["start", "splits"] },
    { "kind": "chapter_enter", "label": "Enter chapter", "required": ["chapter"], "optional": ["side", "sid"], "offer": ["start", "splits"], "allow_no_chapter": true },
    { "kind": "chapter_exit", "label": "Exit chapter", "required": ["chapter"], "optional": ["side", "sid"], "offer": ["start", "splits"], "allow_no_chapter": true },
    { "kind": "chapter_complete", "label": "Chapter complete", "required": [], "optional": ["chapter", "side", "sid", "timing"], "offer": ["splits"] },
    { "kind": "checkpoint", "label": "Checkpoint", "required": ["chapter", "checkpoint"], "optional": ["side"], "offer": ["start", "splits"] },
    { "kind": "heart", "label": "Crystal heart", "required": [], "optional": ["chapter", "side", "sid"], "offer": ["splits"] },
    { "kind": "cassette", "label": "Cassette", "required": [], "optional": ["chapter", "side", "sid"], "offer": ["splits"] },
    { "kind": "room_enter", "label": "Enter room", "required": ["room"], "optional": ["chapter", "side", "sid"], "offer": ["start", "splits"] },
    { "kind": "room_exit", "label": "Exit room", "required": ["room"], "optional": ["chapter", "side", "sid"], "offer": ["start", "splits"] }
  ],

  "presets": [
    {
      "id": "full_game",
      "label": "Full game",
      "settings": { "start": { "kind": "new_file" }, "timing_method": "file", "auto_reset": true },
      "trigger_fields": { "chapter_complete": { "timing": "chapter_exit" } }
    },
    {
      "id": "il",
      "label": "Individual level",
      "settings": { "start": { "kind": "chapter_start" }, "timing_method": "chapter", "auto_reset": true },
      "trigger_fields": { "chapter_complete": { "timing": "chapter_complete" } }
    }
  ],

