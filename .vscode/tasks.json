{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "cargo b",
			"options": {
				"cwd": "${workspaceFolder}/autosplitter"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"group": "build",
			"label": "Build Auto Splitter (Debug)"
		},
		{
			"type": "shell",
			"command": "cargo b --release",
			"options": {
				"cwd": "${workspaceFolder}/autosplitter"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"group": "build",
			"label": "Build Auto Splitter (Release)"
		},
		{
			"type": "shell",
			"command": "dotnet build",
			"options": {
				"cwd": "${workspaceFolder}/component"
			},
			"problemMatcher": "$msCompile",
			"group": "build",
			"label": "Build Component"
		},
		{
			"type": "shell",
			"command": "dotnet test",
			"options": {
				"cwd": "${workspaceFolder}/component"
			},
			"dependsOn": "Build Auto Splitter (Release)",
			"problemMatcher": "$msCompile",
			"group": "test",
			"label": "Test Component"
		},
		{
			"type": "shell",
			"command": "node serve.mjs",
			"options": {
				"cwd": "${workspaceFolder}/site"
			},
			"problemMatcher": [],
			"label": "Serve Site"
		}
	]
}
