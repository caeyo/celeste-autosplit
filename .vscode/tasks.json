{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "cargo b",
			"options": {
				"cwd": "${workspaceFolder}/autosplitter"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"group": "build",
			"label": "Build Auto Splitter (Debug)"
		},
		{
			"type": "shell",
			"command": "cargo b --release",
			"options": {
				"cwd": "${workspaceFolder}/autosplitter"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"group": "build",
			"label": "Build Auto Splitter (Release)"
		},
		{
			"type": "shell",
			// Install the `cargo watch` subcommand from here:
			// https://github.com/watchexec/cargo-watch?tab=readme-ov-file#install
			"command": "cargo watch -x b",
			"options": {
				"cwd": "${workspaceFolder}/autosplitter"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"label": "Watch Auto Splitter"
		},
		{
			"type": "shell",
			"command": "dotnet build",
			"options": {
				"cwd": "${workspaceFolder}/component"
			},
			"problemMatcher": "$msCompile",
			"group": "build",
			"label": "Build Component"
		},
		{
			"type": "shell",
			"command": "dotnet test",
			"options": {
				"cwd": "${workspaceFolder}/component"
			},
			// The tests run the release build of the wasm module.
			"dependsOn": "Build Auto Splitter (Release)",
			"problemMatcher": "$msCompile",
			"group": "test",
			"label": "Test Component"
		},
		{
			"type": "shell",
			"command": "cargo build --release",
			"options": {
				"cwd": "${workspaceFolder}/harness"
			},
			"problemMatcher": [
				"$rustc",
				"$rust-panic"
			],
			"group": "build",
			"label": "Build Harness"
		},
		{
			"type": "shell",
			"command": "cargo run --release --bin harness -- read",
			// Reading another process's memory needs root on macOS.
			"osx": {
				"command": "sudo target/release/harness read"
			},
			"options": {
				"cwd": "${workspaceFolder}/harness"
			},
			// The harness runs the release build of the wasm module, and needs fake-celeste,
			// which only a build of every binary builds.
			"dependsOn": [
				"Build Auto Splitter (Release)",
				"Build Harness"
			],
			"dependsOrder": "sequence",
			"problemMatcher": [],
			"group": "test",
			"label": "Reading Test"
		},
		{
			"type": "shell",
			"command": "node serve.mjs",
			"options": {
				"cwd": "${workspaceFolder}/site"
			},
			"problemMatcher": [],
			"label": "Serve Site"
		}
	]
}
