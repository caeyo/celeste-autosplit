{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Auto Splitter",
            "program": "${userHome}${pathSeparator}.cargo${pathSeparator}bin${pathSeparator}asr-debugger",
            "windows": {
                "program": "${userHome}${pathSeparator}.cargo${pathSeparator}bin${pathSeparator}asr-debugger.exe"
            },
            "preLaunchTask": "Build Auto Splitter (Debug)",
            "args": [
                "--debug",
                "autosplitter${pathSeparator}target${pathSeparator}wasm32-unknown-unknown${pathSeparator}debug${pathSeparator}celeste_autosplit.wasm"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
