{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Auto Splitter",
			// Install the asr-debugger with:
			// cargo install --locked --git https://github.com/LiveSplit/asr-debugger
            "program": "..${pathSeparator}asr-debugger${pathSeparator}asr-debugger",
            "args": [
                "--debug",
                "autosplitter${pathSeparator}target${pathSeparator}wasm32-unknown-unknown${pathSeparator}debug${pathSeparator}celeste_autosplit.wasm"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
